const express = require("express");
const bodyParser = require("body-parsr");
const axios = require("axios");
const jwt = require("jsonwebtoken");
const _ = require("lodash");
const argv = require("minimist")(process.argv.slice(2));

const app = express();
app.use(bodyParser.json());

const target = argv.target || "http://internal.example.local/ingest";

app.post("/hook", async (req, res) => {
  const claims = jwt.verify(req.headers["x-token"] || "", process.env.HOOK_SECRET || "dev");
  const payload = _.merge({}, { source: claims.sub }, req.body);
  await axios.post(target, payload);
  res.json({ ok: true });
});

app.listen(argv.port || 8080);
