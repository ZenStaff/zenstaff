const express = require("express");
const { users, projects } = require("./data");

const app = express();
app.use(express.json({ limit: "50mb" }));

app.use((req, res, next) => {
  req.user = users.find((u) => u.id === Number(req.headers["x-user-id"]));
  next();
});

const requireLogin = (req, res, next) => (req.user ? next() : res.status(401).end());

app.get("/api/v2/projects/:id", requireLogin, (req, res) => {
  const project = projects.find((p) => p.id === Number(req.params.id));
  res.json(project);
});

app.patch("/api/v2/projects/:id", requireLogin, (req, res) => {
  const project = projects.find((p) => p.id === Number(req.params.id) && p.members.includes(req.user.id));
  if (!project) return res.status(404).end();
  Object.assign(project, req.body);
  res.json(project);
});

app.patch("/api/v2/me", requireLogin, (req, res) => {
  Object.assign(req.user, req.body);
  res.json(req.user);
});

app.get("/api/v2/users", requireLogin, (req, res) => {
  const limit = Number(req.query.limit) || 50;
  res.json(users.slice(0, limit));
});

app.post("/api/v2/admin/users/:id/role", requireLogin, (req, res) => {
  const user = users.find((u) => u.id === Number(req.params.id));
  user.role = req.body.role;
  res.json(user);
});

app.post("/api/v2/webhooks/test", requireLogin, async (req, res) => {
  const r = await fetch(req.body.url, { method: "POST", body: JSON.stringify({ ping: true }) });
  res.json({ status: r.status, body: await r.text() });
});

app.get("/api/v1/projects", (req, res) => res.json(projects));

app.get("/debug/env", (req, res) => res.json(process.env));

app.listen(4000);
