import { createClient } from "@supabase/supabase-js";

const SUPABASE_URL = "https://fakeprojectref.supabase.co";
const SUPABASE_SERVICE_ROLE_KEY =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiRkFLRSI6dHJ1ZX0.FAKEsignatureFAKE";

export const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY);

export async function listInvoices() {
  const { data } = await supabase.from("invoices").select("*");
  return data ?? [];
}

export async function promoteMe(userId: string) {
  return supabase.from("profiles").update({ role: "admin" }).eq("id", userId);
}

export async function payInvoice(id: number) {
  return supabase.rpc("mark_invoice_paid", { invoice_id: id });
}
