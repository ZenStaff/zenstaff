{
  "id": "crawlee",
  "name": "Crawlee (polite crawler for public lists)",
  "nameRo": "Crawlee (cititor politicos pentru liste publice)",
  "kind": "npm",
  "description": "Walks long public lists page by page (HTTP only, no browser): a queue, retries, 2 requests at a time. Zen Staff's own rules (robots.txt, site terms, pauses) decide what may be read.",
  "homepage": "https://crawlee.dev/",
  "license": {
    "spdx": "Apache-2.0",
    "name": "Apache License 2.0",
    "url": "https://github.com/apify/crawlee/blob/master/LICENSE.md",
    "commercialUse": "free",
    "note": "Free for any use, including business (Apache-2.0). Websites' own terms still apply to what you read with it.",
    "noteRo": "Gratuit pentru orice folosire, inclusiv în firme (Apache-2.0). Termenii fiecărui site rămân valabili pentru ce citești cu el."
  },
  "untrustedInput": true,
  "verify": {
    "bin": "",
    "args": [],
    "expect": ""
  },
