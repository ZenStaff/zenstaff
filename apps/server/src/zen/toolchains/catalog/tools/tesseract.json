{
  "id": "tesseract",
  "name": "Text from scans (Tesseract, Romanian and English)",
  "nameRo": "Text din scanări (Tesseract, română și engleză)",
  "kind": "python",
  "description": "Reads the text of scans and photos (invoices, receipts, statements), on this computer, with Romanian and English language data.",
  "homepage": "https://github.com/tesseract-ocr/tesseract",
  "license": {
    "spdx": "Apache-2.0",
    "name": "Apache 2.0 (Tesseract, language data); MIT (tesserocr, openpyxl); MIT-CMU (Pillow); Apache-2.0 / BSD-3-Clause (pypdfium2)",
    "url": "https://github.com/tesseract-ocr/tesseract/blob/main/LICENSE",
    "commercialUse": "free",
    "note": "Free for any use, including business. The text it reads from your documents is yours.",
    "noteRo": "Gratuit pentru orice folosire, inclusiv \u00een firme. Textul citit din documentele voastre este al vostru."
  },
  "untrustedInput": true,
  "verify": {
    "bin": "ocr-python",
    "args": [
      "-c",
      "import os, sys, tesserocr, pypdfium2, openpyxl, PIL; d = os.path.join(sys.prefix, '..', 'tessdata'); print('tesseract', tesserocr.tesseract_version().split()[1], 'langs', '+'.join(sorted(tesserocr.get_languages(d)[1])))"
    ],
    "expect": "tesseract 5\\.5\\.3 langs eng\\+ron"
  },
  "osv": [],
  "versions": [
    {
      "version": "5.5.3",
